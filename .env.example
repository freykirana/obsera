# Frontend (Next.js). Copy to .env.local.

# Backend base URL called from the browser. Inlined at build time, so on Vercel set it
# before building. The backend must allow this frontend's origin (FRONTEND_URL in backend/.env).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Backend base URL for server-side code (Next.js route handlers). Optional: defaults to
# NEXT_PUBLIC_API_URL; set it when the server reaches the backend on another address.
BACKEND_URL=http://localhost:4000
