# Honeypot agent. Copy to agent/.env on the Cowrie host.

# Obsera backend base URL
OBSERA_API_URL=http://localhost:4000
# Required. Must match INGEST_TOKEN in backend/.env
OBSERA_INGEST_TOKEN=

# Cowrie JSON log to follow
COWRIE_LOG_PATH=/home/cowrie/cowrie/var/log/cowrie/cowrie.json

# Name shown in the dashboard (defaults to the hostname)
SENSOR_ID=
HEARTBEAT_INTERVAL_MS=60000
# Directory for honeypot-agent.log (defaults to the system temp directory)
LOG_DIR=
