# Backend (Express + Prisma). Copy to backend/.env.

PORT=4000
NODE_ENV=development
# Origin allowed by CORS
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/honeypot_db?schema=public

# Signs dashboard session tokens. Generate: openssl rand -hex 32
JWT_SECRET=

# Shared secret the honeypot agent sends as "Authorization: Bearer <token>".
# Must match OBSERA_INGEST_TOKEN in agent/.env. Generate: openssl rand -hex 32
INGEST_TOKEN=

# Admin account created by `npm run prisma:seed`.
# Leave the password empty to generate a random one (printed once).
SEED_ADMIN_EMAIL=admin@obsera.local
SEED_ADMIN_PASSWORD=
